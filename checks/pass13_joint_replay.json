    "output": "@Paper.lem_balanced : ∀ {R T : Type} [inst : CommSemiring R] [inst_1 : Fintype T] [inst_2 : DecidableEq T] {k : ℕ}\n  {P : MvPolynomial (Fin k × T) R} {L : ℕ},\n  Nc.Computes P L →\n    2 ≤ k →\n      ∃ g q,\n        Paper.linearPart P =\n          ∑ S with k ≤ 3 * S.card ∧ 3 * S.card ≤ 2 * k, ∑ δ, Paper.linearIn S (g S δ) * Paper.linearIn Sᶜ (q S δ)\n@Paper.lem_balanced_cf : ∀ {R T : Type} [inst : CommSemiring R] [Fintype T] [DecidableEq T] {k : ℕ}\n  {P : MvPolynomial (Fin k × T) R} {L : ℕ},\n  Nc.Computes P L →\n    2 ≤ k →\n      ∃ g q,\n        ∀ (y : Fin k → T),\n          Nc.CaseI.cf Finset.univ P y = ∑ S ∈ Nc.CaseI.bal Finset.univ, ∑ δ, (g S δ fun a => y ↑a) * q S δ fun a => y ↑a\n@Paper.prop_flat_lower_sum : ∀ {K : Type} [inst : Field K] {I : Type} [inst_1 : Fintype I] [inst_2 : DecidableEq I]\n  {k : ℕ},\n  2 ≤ k →\n    ∀ {ℓ L : ℕ} {P : MvPolynomial (Fin k × Nc.CaseI.Ix k ℓ) K},\n      Nc.Computes P L →\n        ∀ (π : Nc.CaseI.End k → I) (hub : Finset (Fin k) → Bool → I),\n          (Ov.Ten.push π ((Paper.fklTen K k ℓ).withVal fun z => Nc.CaseI.cf Finset.univ P (Paper.tables z))).SumRestr\n            fun S => Paper.hubTen K ℓ L π hub ↑S\n@Paper.thm_laws_poincare : ∀ {K : Type} [inst : Field K],\n  Paper.Contracting K →\n    ∃ u,\n      2 ≤ u ∧\n        ∃ C C₀,\n          0 ≤ C ∧\n            Paper.PoincareBound K u C ∧\n              2 * C + 1 ≤ ↑C₀ ∧\n                ∀ (h : ℕ) [inst_1 : NeZero h],\n                  u ∣ h →\n                    2 * u ≤ h →\n                      ∀ (w : ↥(Nc.Tower.U h) → ↥(Nc.Tower.U h) → ℝ),\n                        Nc.Price.IsPrice K w →\n                          (∑ p, ∑ q, w p q ^ 2) /\n                              (↑(Fintype.card ↥(Nc.Tower.U h)) * (↑(Fintype.card ↥(Nc.Tower.U h)) - 1)) ≤\n                            ↑C₀ * (2 / ↑(Fintype.card ↥(Nc.Tower.U h)) * ∑ ν, w (Nc.Vp.cNear ν) (Nc.Vp.dNear ν) ^ 2)\n@Paper.thm_laws_cover : ∀ {K : Type} [inst : Field K] {V E N B : Type} [inst_1 : Fintype V] [DecidableEq V] [Nonempty V]\n  [inst_4 : Fintype E] [DecidableEq E] [inst_6 : Fintype N] [inst_7 : DecidableEq N] [inst_8 : Fintype B]\n  [DecidableEq B] (a b : E → V) (c d : N → V) (σ : E → ℕ) (ℬ : B → N → ℕ),\n  (∀ (w : V → V → ℝ), Nc.Price.IsPrice K w → ∃ β, ∑ e, ↑(σ e) * w (a e) (b e) ≤ ∑ ν, ↑(ℬ β ν) * w (c ν) (d ν)) →\n    ∀ {ε : ℝ},\n      0 < ε →\n        ∃ q₀,\n          ∀ (q : ℕ),\n            q₀ ≤ q →\n              ∃ m v,\n                ↑m ≤ 2 ^ (ε * ↑q) ∧\n                  (∀ (i : Fin m), ∑ β, v i β = q) ∧\n                    ∃ tab,\n                      Nc.Price.BitId K (fun s => a s.fst) (fun s => b s.fst) c d (fun i ν => ∑ β, v i β * ℬ β ν) tab\n@Paper.thm_laws_over_field : ∀ {K : Type} [inst : Field K] {h : ℕ} [inst_1 : NeZero h],\n  2 ≤ h →\n    ∀ {C₀ : ℕ},\n      1 ≤ C₀ →\n        (∀ (w : ↥(Nc.Tower.U h) → ↥(Nc.Tower.U h) → ℝ),\n            Nc.Price.IsPrice K w →\n              (∑ p, ∑ q, w p q ^ 2) / (↑(Fintype.card ↥(Nc.Tower.U h)) * (↑(Fintype.card ↥(Nc.Tower.U h)) - 1)) ≤\n                ↑C₀ * (2 / ↑(Fintype.card ↥(Nc.Tower.U h)) * ∑ ν, w (Nc.Vp.cNear ν) (Nc.Vp.dNear ν) ^ 2)) →\n          ∃ a₁ Di x L ro cn,\n            0 < a₁ ∧\n              (∀ (d : Di) (ν : (L d).Cn),\n                  s((ro d) ((L d).c ν), (ro d) ((L d).d ν)) = s(Nc.Vp.cNear ((cn d) ν), Nc.Vp.dNear ((cn d) ν))) ∧\n                (∀ (d : Di), 1 ≤ (L d).lam ∧ Nonempty (L d).I) ∧\n                  (∀ (n : Sym2 ↥(Nc.Tower.U h) → ℕ) (t : ℕ),\n                      √(↑(Fintype.card ↥(Nc.Tower.U h)) * (↑(Fintype.card ↥(Nc.Tower.U h)) - 1) / 2 *\n                              ∑ q, if q.IsDiag then 0 else ↑(n q) ^ 2) ≤\n                          ↑a₁ * ↑t →\n                        ∃ d,\n                          ∀ (q : Sym2 ↥(Nc.Tower.U h)),\n                            ¬q.IsDiag → n q ≤ {e | s((ro d) ((L d).a e), (ro d) ((L d).b e)) = q}.card * t) ∧\n                    ∀ (d : Di) (i : (L d).I),\n                      √(↑(Fintype.card ↥(Nc.Tower.U h)) / 2 * ∑ ν, ↑((L d).lam + (L d).len i ν) ^ 2) ≤ √(4 * ↑C₀) * ↑a₁\n@Paper.thm_laws : ∀ {K : Type} [inst : Field K],\n  Paper.Contracting K →\n    ∃ u,\n      2 ≤ u ∧\n        ∃ C C₀,\n          0 ≤ C ∧\n            Paper.PoincareBound K u C ∧\n              2 * C + 1 ≤ ↑C₀ ∧\n                (∃ h, u ∣ h ∧ 2 * u ≤ h ∧ 3 ≤ h ∧ 1 + 8 * (4 * ↑C₀) ≤ ↑h / 4) ∧\n                  ∀ (h : ℕ) [inst_1 : NeZero h],\n                    u ∣ h →\n                      2 * u ≤ h →\n                        3 ≤ h →\n                          1 + 8 * (4 * ↑C₀) ≤ ↑h / 4 →\n                            ∃ A,\n                              ∃ (_ : Algebra.FiniteType ℤ ↥A),\n                                ∃ a₁ Di x L ro cn,\n                                  0 < a₁ ∧\n                                    (∀ (d : Di) (ν : (L d).Cn),\n                                        s((ro d) ((L d).c ν), (ro d) ((L d).d ν)) =\n                                          s(Nc.Vp.cNear ((cn d) ν), Nc.Vp.dNear ((cn d) ν))) ∧\n                                      (∀ (d : Di), 1 ≤ (L d).lam ∧ Nonempty (L d).I) ∧\n                                        (∀ (n : Sym2 ↥(Nc.Tower.U h) → ℕ) (t : ℕ),\n                                            √(↑(Fintype.card ↥(Nc.Tower.U h)) * (↑(Fintype.card ↥(Nc.Tower.U h)) - 1) /\n                                                      2 *\n                                                    ∑ q, if q.IsDiag then 0 else ↑(n q) ^ 2) ≤\n                                                ↑a₁ * ↑t →\n                                              ∃ d,\n                                                ∀ (q : Sym2 ↥(Nc.Tower.U h)),\n                                                  ¬q.IsDiag →\n                                                    n q ≤\n                                                      {e | s((ro d) ((L d).a e), (ro d) ((L d).b e)) = q}.card * t) ∧\n                                          ∀ (d : Di) (i : (L d).I),\n                                            √(↑(Fintype.card ↥(Nc.Tower.U h)) / 2 *\n                                                  ∑ ν, ↑((L d).lam + (L d).len i ν) ^ 2) ≤\n                                              √(4 * ↑C₀) * ↑a₁\n@Paper.exists_laws : ∀ {K : Type} [inst : Field K],\n  Paper.Contracting K →\n    ∃ h,\n      ∃ (x : NeZero h),\n        3 ≤ h ∧ ∃ A, ∃ (_ : Algebra.FiniteType ℤ ↥A), ∃ VL, 1 + 8 * VL.C₁ ≤ ↑h / 4 ∧ ∃ g, 2 * VL.C₁ * ↑VL.a₁ ^ 2 = ↑g\n'Paper.lem_balanced' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Paper.lem_balanced_cf' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Paper.prop_flat_lower_sum' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Paper.thm_laws_poincare' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Paper.thm_laws_cover' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Paper.thm_laws_over_field' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Paper.thm_laws' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Paper.exists_laws' depends on axioms: [propext, Classical.choice, Quot.sound]\n@Paper.thm_poincare : ∀ {K : Type} [inst : Field K],\n  Paper.Contracting K →\n    ∃ u,\n      2 ≤ u ∧\n        ∃ C₀,\n          0 ≤ C₀ ∧\n            ∀ (l : ℕ),\n              2 ≤ l →\n                ∀ (w : ↥(Nc.Tower.U (l * u)) → ↥(Nc.Tower.U (l * u)) → ℝ),\n                  Nc.Price.IsPrice K w →\n                    (∑ g, ∑ k, w k (g * k) ^ 2) / ↑(Fintype.card ↥(Nc.Tower.U (l * u))) ^ 2 ≤\n                      C₀ * ∑ j, (∑ k, w k (Nc.Tower.x (l * u) j * k) ^ 2) / ↑(Fintype.card ↥(Nc.Tower.U (l * u)))\n@Paper.thm_duality : ∀ {K : Type} [inst : Field K] {I : Type} [inst_1 : Fintype I] [inst_2 : DecidableEq I] [Nonempty I]\n  {B : Type} [inst_4 : Fintype B] [inst_5 : DecidableEq B] {C : Ov.Ten K I} {A : B → Ov.Ten K I},\n  (∃ x, C.val x ≠ 0) →\n    (∃ β x, (A β).val x ≠ 0) →\n      (∀ (φ : Ov.Spec K I), ∃ β, φ.F C ≤ φ.F (A β)) →\n        ∀ {ε : ℝ},\n          0 < ε →\n            ∃ N₀,\n              ∀ (N : ℕ),\n                N₀ ≤ N →\n                  ∃ m v,\n                    ↑m ≤ 2 ^ (ε * ↑N) ∧\n                      (∀ (i : Fin m), ∑ β, v i β = N) ∧\n                        (C.kpow N).SumRestr fun i => Ov.Ten.prod fun β => (A β).kpow (v i β)\n'Paper.thm_poincare' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Paper.thm_duality' depends on axioms: [propext, Classical.choice, Quot.sound]",
