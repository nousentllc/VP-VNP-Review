    "output": "Nc.Price.IsPrice : (K : Type) → [Field K] → {Y : Type u_1} → (Y → Y → ℝ) → Prop\n@Cat.CN.exists_mid : ∀ {X : Type u_1} {inst : MetricSpace X} [self : Cat.CN X] (x v : X),\n  ∃ m, ∀ (z : X), dist z m ^ 2 ≤ (dist z x ^ 2 + dist z v ^ 2) / 2 - dist x v ^ 2 / 4\nPaper.def_cases : ∀ (K : Type) [inst : Field K],\n  (Paper.Flat K ↔ ∀ (n : ℕ) (S : Finset (EuclideanSpace ℝ (Fin n))), Nc.Price.IsPrice K fun x y => dist x y) ∧\n    (Paper.Contracting K ↔\n      ∃ μ s,\n        2 ≤ μ ∧\n          1 ≤ s ∧\n            s ^ 2 < ↑μ ∧\n              ∀ (w : Nc.Flag.Mt μ → Nc.Flag.Mt μ → ℝ),\n                Nc.Price.IsPrice K w →\n                  √((∑ a, ∑ W with Matrix.rank W = μ, w a (a + W) ^ 2) /\n                        (↑(Fintype.card (Nc.Flag.Mt μ)) * ↑{W | Matrix.rank W = μ}.card)) ≤\n                    s *\n                      √((∑ a, ∑ W with Matrix.rank W = 1, w a (a + W) ^ 2) /\n                          (↑(Fintype.card (Nc.Flag.Mt μ)) * ↑{W | Matrix.rank W = 1}.card)))\n'Paper.def_cases' depends on axioms: [propext, Classical.choice, Quot.sound]\n@Paper.lem_hubs : ∀ {K : Type} [inst : Field K] {I : Type} [inst_1 : Fintype I] [inst_2 : DecidableEq I] {A : Type}\n  [inst_3 : Fintype A] [inst_4 : DecidableEq A] (π : A → I) (t : Ov.Ten K A) (S : A → Prop) [inst_5 : DecidablePred S]\n  {r : ℕ} (α β : Fin r → ((a : A) → t.ι a) → K),\n  (∀ (j : Fin r) (x x' : (a : A) → t.ι a), (∀ (a : A), S a → x a = x' a) → α j x = α j x') →\n    (∀ (j : Fin r) (x x' : (a : A) → t.ι a), (∀ (a : A), ¬S a → x a = x' a) → β j x = β j x') →\n      (∀ (x : (p : A) → t.ι p), t.val x = ∑ j, α j x * β j x) →\n        ∀ (o₁ o₂ : I),\n          (Ov.Ten.push π t).Restr\n            ((Ov.Ten.prod fun a => Ov.Ten.wire K (Fintype.card (t.ι a)) (π a) (if S a then o₁ else o₂)) *\n              Ov.Ten.wire K r o₁ o₂)\n'Paper.lem_hubs' depends on axioms: [propext, Classical.choice, Quot.sound]\n@Paper.prop_space_midpoints : ∀ {K : Type} [inst : Field K] {V : Type} {w : V → V → ℝ},\n  Nc.Price.IsPrice K w →\n    ∃ d,\n      Nc.Price.IsPrice K d ∧\n        (∀ (a b : V), d (Cat.Term.of a) (Cat.Term.of b) = w a b) ∧\n          ∀ (s t : Cat.Term V), d s (s.mid t) ≤ d s t / 2 ∧ d t (s.mid t) ≤ d s t / 2\n'Paper.prop_space_midpoints' depends on axioms: [propext, Classical.choice, Quot.sound]\n@Paper.prop_space_completion : ∀ {X : Type u_1} [inst : MetricSpace X] [CompleteSpace X] {S : Set X},\n  Dense S →\n    (∀ x ∈ S, ∀ v ∈ S, ∃ m, ∀ z ∈ S, dist z m ^ 2 ≤ (dist z x ^ 2 + dist z v ^ 2) / 2 - dist x v ^ 2 / 4) → Cat.CN X\n'Paper.prop_space_completion' depends on axioms: [propext, Classical.choice, Quot.sound]\n@Paper.prop_space_limit : ∀ {K : Type} [inst : Field K] {T : Type} [inst_1 : PseudoMetricSpace T],\n  (Nc.Price.IsPrice K fun s t => dist s t) → Nc.Price.IsPrice K fun a b => dist a b\n'Paper.prop_space_limit' depends on axioms: [propext, Classical.choice, Quot.sound]\n@Paper.prop_space : ∀ {K : Type} [inst : Field K] {V : Type} {w : V → V → ℝ},\n  Nc.Price.IsPrice K w →\n    ∃ X x, ∃ (_ : Cat.CN X), ∃ f, (Nc.Price.IsPrice K fun a b => dist a b) ∧ ∀ (a b : V), dist (f a) (f b) = w a b\n'Paper.prop_space' depends on axioms: [propext, Classical.choice, Quot.sound]\n@Paper.thm_cn : ∀ {K : Type} [inst : Field K] {Y : Type} {w : Y → Y → ℝ},\n  Nc.Price.IsPrice K w →\n    ∀ (x v m z : Y) {D : ℝ},\n      w x m ≤ D → w v m ≤ D → w x v = 2 * D → w z m ^ 2 ≤ 1 / 2 * w z x ^ 2 + 1 / 2 * w z v ^ 2 - D ^ 2\n'Paper.thm_cn' depends on axioms: [propext, Classical.choice, Quot.sound]\n@Paper.thm_alt_rank_price : ∀ {K : Type} [inst : Field K] {μ : ℕ},\n  ¬Paper.Contracting K →\n    3 ≤ μ → ∃ w, Nc.Price.IsPrice K w ∧ ∀ (a a' : Nc.Flag.Mt μ), w a a' ^ 2 = ↑(Matrix.rank (a - a'))\n'Paper.thm_alt_rank_price' depends on axioms: [propext, Classical.choice, Quot.sound]\n@Paper.thm_alt_euclidean : ∀ {K : Type} [inst : Field K] {μ : ℕ},\n  ¬Paper.Contracting K →\n    3 ≤ μ →\n      ∀ {k : ℕ},\n        k ≤ μ →\n          ∀ (V : Type) [Finite V] (E : V → EuclideanSpace ℝ (Fin k)),