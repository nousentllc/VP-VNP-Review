@W05.need_le_iff : ∀ {I : Type u_1} (rs : List I) (u s : I → ℝ) (t : ℝ),
  W05.need rs u s ≤ t ↔ 0 ≤ t ∧ ∀ i ∈ rs, W05.rowNeed (u i) (s i) ≤ t
'W05.need_le_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.rowNeed_iff : ∀ {u s t : ℝ}, 0 ≤ s → 0 ≤ t → t ≤ 1 → (W05.rowNeed u s ≤ t ↔ (1 - t) * u - t * s ≤ 0)
'W05.rowNeed_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.need_unit : ∀ {I : Type u_1} (rs : List I) (u s : I → ℝ),
  (∀ i ∈ rs, 0 ≤ s i) → 0 ≤ W05.need rs u s ∧ W05.need rs u s ≤ 1
'W05.need_unit' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.minimal_fraction : ∀ {I : Type u_1} (rs : List I) (u s : I → ℝ),
  (∀ i ∈ rs, 0 ≤ s i) → ∀ {t : ℝ}, 0 ≤ t → t ≤ 1 → (W05.need rs u s ≤ t ↔ ∀ i ∈ rs, (1 - t) * u i - t * s i ≤ 0)
'W05.minimal_fraction' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.empty_rows : ∀ {I : Type u_1} (u s : I → ℝ), W05.need [] u s = 0
'W05.empty_rows' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.boundary_fallback : ∀ {I : Type u_1} (rs : List I) (u s : I → ℝ),
  (∀ i ∈ rs, 0 ≤ s i) → ∀ {i : I}, i ∈ rs → 0 < u i → s i = 0 → W05.need rs u s = 1
'W05.boundary_fallback' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.envelope : ∀ {I : Type u_1} (rs : List I) (u h s : I → ℝ),
  (∀ i ∈ rs, 0 ≤ s i) → (∀ i ∈ rs, u i ≤ h i) → W05.need rs u s ≤ W05.need rs h s
'W05.envelope' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.uniform_fraction : ∀ {I : Type u_1} (rs : List I) (u s : I → ℝ) {bar sigma : ℝ},
  0 ≤ bar → 0 < sigma → (∀ i ∈ rs, 0 < u i → u i ≤ bar ∧ sigma ≤ s i) → W05.need rs u s ≤ bar / (bar + sigma)
'W05.uniform_fraction' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.affine_mix : ∀ {V : Type u_1} [inst : NormedAddCommGroup V] [inst_1 : NormedSpace ℝ V] (g : V →ᵃ[ℝ] ℝ) (x a : V)
  (t : ℝ), g (W05.mix t x a) = (1 - t) * g x + t * g a
'W05.affine_mix' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.objective_identity : ∀ {V : Type u_1} [inst : NormedAddCommGroup V] [inst_1 : NormedSpace ℝ V] (J : V →ᵃ[ℝ] ℝ)
  (x a : V) (t : ℝ), J (W05.mix t x a) - J x = t * (J a - J x)
'W05.objective_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.feasible_anchor : ∀ {V : Type u_1} {I : Type u_2} {G : Type u_3} [inst : NormedAddCommGroup V]
  [inst_1 : NormedSpace ℝ V] (S : Set V),
  Convex ℝ S →
    ∀ (x a : V),
      x ∈ S →
        a ∈ S →
          ∀ (rows : List I) (g : I → V →ᵃ[ℝ] ℝ) (e : G → V →ᵃ[ℝ] ℝ),
            (∀ (j : G), (e j) x = 0) →
              (∀ (j : G), (e j) a = 0) →
                (∀ i ∈ rows, (g i) a ≤ 0) →
                  have t := W05.need rows (fun i => (g i) x) fun i => -(g i) a;
                  W05.mix t x a ∈ S ∧ (∀ (j : G), (e j) (W05.mix t x a) = 0) ∧ ∀ i ∈ rows, (g i) (W05.mix t x a) ≤ 0
'W05.feasible_anchor' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.equality_obstruction : ∀ {V : Type u_1} [inst : NormedAddCommGroup V] [inst_1 : NormedSpace ℝ V] (e : V →ᵃ[ℝ] ℝ)
  (x a : V), e a = 0 → ∀ (t : ℝ), e (W05.mix t x a) = 0 ↔ t = 1 ∨ e x = 0
'W05.equality_obstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.lipschitz_loss : ∀ {V : Type u_1} [inst : NormedAddCommGroup V] [inst_1 : NormedSpace ℝ V] (J : V → ℝ) (x a : V)
  {L D t : ℝ},
  0 ≤ L →
    0 ≤ t →
      |J (W05.mix t x a) - J x| ≤ L * ‖W05.mix t x a - x‖ → ‖a - x‖ ≤ D → max 0 (J (W05.mix t x a) - J x) ≤ L * t * D
'W05.lipschitz_loss' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.uniform_loss : ∀ {V : Type u_1} {I : Type u_2} [inst : NormedAddCommGroup V] [inst_1 : NormedSpace ℝ V] (J : V → ℝ)
  (S : Set V),
  Convex ℝ S →
    ∀ (x a : V),
      x ∈ S →
        a ∈ S →
          ∀ (rows : List I) (u s : I → ℝ),
            (∀ i ∈ rows, 0 ≤ s i) →
              ∀ {L D bar sigma : ℝ},
                0 ≤ L →
                  (∀ z ∈ S, ∀ v ∈ S, |J z - J v| ≤ L * ‖z - v‖) →
                    ‖a - x‖ ≤ D →
                      0 ≤ bar →
                        0 < sigma →
                          (∀ i ∈ rows, 0 < u i → u i ≤ bar ∧ sigma ≤ s i) →
                            max 0 (J (W05.mix (W05.need rows u s) x a) - J x) ≤ L * D * (bar / (bar + sigma))
'W05.uniform_loss' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.equality_repair : ∀ {V : Type u_1} {W : Type u_2} [inst : AddCommGroup V] [inst_1 : Module ℝ V]
  [inst_2 : AddCommGroup W] [inst_3 : Module ℝ W] (E : V →ₗ[ℝ] W) (R : W →ₗ[ℝ] V) (x : V) (d : W),
  E (R (d - E x)) = d - E x → E (x + R (d - E x)) = d
'W05.equality_repair' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.right_inverse_repair : ∀ {V : Type u_1} {W : Type u_2} [inst : AddCommGroup V] [inst_1 : Module ℝ V]
  [inst_2 : AddCommGroup W] [inst_3 : Module ℝ W] (E : V →ₗ[ℝ] W) (R : W →ₗ[ℝ] V),
  Function.RightInverse ⇑R ⇑E → ∀ (x : V) (d : W), E (x + R (d - E x)) = d
'W05.right_inverse_repair' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.corner_bound : ∀ {q l h x : ℝ}, l ≤ x → x ≤ h → q * x ≤ max (q * l) (q * h)
'W05.corner_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.affine_box_support : ∀ {I : Type u_1} [inst : Fintype I] (q l h x : I → ℝ),
  (∀ (i : I), l i ≤ x i) →
    (∀ (i : I), x i ≤ h i) → ∀ (offset : ℝ), offset + ∑ i, q i * x i ≤ offset + ∑ i, max (q i * l i) (q i * h i)
'W05.affine_box_support' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.projection_support : ∀ {X : Type u_1} {Y : Type u_2} {I : Type u_3} [inst : Fintype I] (J : X → ℝ) (K : Y → ℝ)
  (p : X → Y) (coord : X → I → ℝ) (q l h : I → ℝ) (offset : ℝ),
  (∀ (x : X) (i : I), l i ≤ coord x i) →
    (∀ (x : X) (i : I), coord x i ≤ h i) →
      (∀ (x : X), K (p x) - J x = offset + ∑ i, q i * coord x i) →
        ∀ (x : X), K (p x) ≤ J x + max 0 (offset + ∑ i, max (q i * l i) (q i * h i))
'W05.projection_support' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.outer_embedding : ∀ {X : Type u_1} {Y : Type u_2} (J : X → ℝ) (K : Y → ℝ) (p : X → Y),
  (∀ (x : X), K (p x) = J x) → ∀ (x : X), K (p x) ≤ J x + 0
'W05.outer_embedding' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.cost_mismatch : ∀ {jx ku ja jfixed t tau : ℝ},
  jfixed - jx = t * (ja - jx) → jx - ku ≤ tau → jfixed ≤ ku + max 0 (tau + t * (ja - jx))
'W05.cost_mismatch' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.aipc_from_repair : ∀ {X : Type u_1} {Y : Type u_2} {J : X → ℝ} {K : Y → ℝ} {a beta eps : ℝ},
  BddBelow (Set.range J) →
    BddBelow (Set.range K) →
      ∀ (p : X → Y),
        (∀ (u : X), K (p u) ≤ J u + a) →
          ∀ (y : Y) (x : X),
            K y ≤ W04.value K + eps → J x - K y ≤ beta → 0 ≤ J x - W04.value J ∧ J x - W04.value J ≤ a + beta + eps
'W05.aipc_from_repair' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.uniform_affine_beta : ∀ {jfinal jraw ja betaRaw D cap t : ℝ},
  jfinal - jraw = t * (ja - jraw) →
    jraw ≤ betaRaw → 0 ≤ t → t ≤ cap → 0 ≤ D → ja - jraw ≤ D → jfinal ≤ betaRaw + cap * D
'W05.uniform_affine_beta' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.Terminal.row_headroom : ∀ {u s q : ℝ}, 0 ≤ s → 0 ≤ q → (u * q ≤ s ↔ 0 < u → q ≤ s / u)
'W05.Terminal.row_headroom' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.Terminal.single_slot_iff : ∀ {I : Type u_1} (s u : I → ℝ),
  (∀ (i : I), 0 ≤ s i) →
    ∀ (e target p : ℝ),
      0 < p →
        e ≤ target →
          ((∃ q, 0 ≤ q ∧ e + p * q = target ∧ ∀ (i : I), u i * q ≤ s i) ↔
            ∀ (i : I), 0 < u i → (target - e) / p ≤ s i / u i)
'W05.Terminal.single_slot_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
@W05.Terminal.signed_slot_iff : ∀ {I : Type u_1} (s u : I → ℝ),
  (∀ (i : I), 0 ≤ s i) →
    ∀ (e target p : ℝ),
      p ≠ 0 →
        0 ≤ (target - e) / p →
          ((∃ q, 0 ≤ q ∧ e + p * q = target ∧ ∀ (i : I), u i * q ≤ s i) ↔
            ∀ (i : I), 0 < u i → (target - e) / p ≤ s i / u i)
'W05.Terminal.signed_slot_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
W05.Terminal.suffix_shift : ∀ (initial delta : ℝ) (increment : ℕ → ℝ) (slot t : ℕ),
  initial + ∑ k ∈ Finset.range t, (increment k + if k = slot then delta else 0) =
    initial + ∑ k ∈ Finset.range t, increment k + if slot < t then delta else 0
'W05.Terminal.suffix_shift' depends on axioms: [propext, Classical.choice, Quot.sound]
W05.Terminal.adjacent_ramps : ∀ (before current after pulse : ℝ),
  current + pulse - before = current - before + pulse ∧ after - (current + pulse) = after - current - pulse
'W05.Terminal.adjacent_ramps' depends on axioms: [propext, Classical.choice, Quot.sound]
W05.Terminal.soc_increment : ∀ (e eta rho c d dc dd hours : ℝ),
