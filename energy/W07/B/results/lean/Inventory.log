@W07.Info.strengthen : ∀ {S : Type u_1} {T : Type u_2} {A : Type u_3} (F : Set (T → S → A)) (D E : T → S → S → Prop),
  (∀ (t : T) (i j : S), D t i j → E t i j) → W07.Info.relaxedDomain F E ⊆ W07.Info.relaxedDomain F D
'W07.Info.strengthen' does not depend on any axioms
@W07.Info.projection : ∀ {S : Type u_1} {T : Type u_2} {H : Type u_3} {A : Type u_4} (F : Set (T → S → A))
  (D : T → S → S → Prop) (hist : T → S → H) (policy : T → H → A),
  (∀ (t : T) (i j : S), D t i j → hist t i = hist t j) →
    (fun t s => policy t (hist t s)) ∈ F → (fun t s => policy t (hist t s)) ∈ W07.Info.relaxedDomain F D
'W07.Info.projection' does not depend on any axioms
@W07.Info.lower_transfer : ∀ {P : Type u_1} (J : P → ℝ) {F : Set P} {l : ℝ},
  F.Nonempty → (∀ p ∈ F, l ≤ J p) → l ≤ W07.Info.value J F
'W07.Info.lower_transfer' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Info.restrict_value : ∀ {P : Type u_1} (J : P → ℝ) {large small : Set P},
  small ⊆ large → small.Nonempty → BddBelow (J '' large) → W07.Info.value J large ≤ W07.Info.value J small
'W07.Info.restrict_value' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Info.nested_information : ∀ {P : Type u_1} (J : P → ℝ) {pf d₁ d₂ causal deadline : Set P} {b : P},
  d₁ ⊆ pf →
    d₂ ⊆ d₁ →
      causal ⊆ d₂ →
        deadline ⊆ causal →
          b ∈ deadline →
            BddBelow (J '' pf) →
              W07.Info.value J pf ≤ W07.Info.value J d₁ ∧
                W07.Info.value J d₁ ≤ W07.Info.value J d₂ ∧
                  W07.Info.value J d₂ ≤ W07.Info.value J causal ∧
                    W07.Info.value J causal ≤ W07.Info.value J deadline ∧ W07.Info.value J deadline ≤ J b
'W07.Info.nested_information' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Info.max_floor : ∀ {a b j : ℝ}, a ≤ j → b ≤ j → max a b ≤ j
'W07.Info.max_floor' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Info.strict_stop : ∀ {U L J ε : ℝ}, L ≤ J → U - L < ε → ¬ε ≤ U - J
'W07.Info.strict_stop' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Info.equality_stop_nonattained : ∀ {U L J ε : ℝ}, L < J → U - L = ε → ¬ε ≤ U - J
'W07.Info.equality_stop_nonattained' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Info.covered_weight : ∀ {S : Type u_1} [inst : Fintype S] (w u j l b : S → ℝ) (valid : S → Prop)
  [inst_1 : DecidablePred valid],
  (∀ (s : S), 0 ≤ w s) →
    (∀ (s : S), u s ≤ b s) →
      (∀ (s : S), valid s → l s ≤ j s) →
        ∀ (backup : S → ℝ),
          (∀ (s : S), ¬valid s → backup s ≤ j s) →
            ∑ s, w s * (u s - j s) ≤ ∑ s, w s * (b s - if valid s then l s else backup s)
'W07.Info.covered_weight' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Info.penalty_transfer : ∀ {P : Type u_1} {Q : Type u_2} (causal : Set P) (relax : Set Q) (map : P → Q) (J : P → ℝ)
  (F M : Q → ℝ) (L : ℝ),
  (∀ p ∈ causal, map p ∈ relax) →
    (∀ p ∈ causal, F (map p) ≤ J p) →
      (∀ p ∈ causal, M (map p) ≤ 0) → (∀ z ∈ relax, L ≤ F z + M z) → ∀ p ∈ causal, L ≤ J p
'W07.Info.penalty_transfer' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Info.history_centering : ∀ {S : Type u_1} {H : Type u_2} {A : Type u_3} [inst : Fintype S] [Fintype H]
  [inst_2 : DecidableEq H] (w : S → ℝ) (hist : S → H) (inc : S → A → ℝ) (choose : H → A),
  (∀ (h : H) (a : A), (∑ s, if hist s = h then w s * inc s a else 0) = 0) → ∑ s, w s * inc s (choose (hist s)) = 0
'W07.Info.history_centering' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Info.accumulated_centering : ∀ {S : Type u_1} {T : Type u_2} [inst : Fintype S] [inst_1 : Fintype T] (w : S → ℝ)
  (m : T → S → ℝ), (∀ (t : T), ∑ s, w s * m t s = 0) → ∑ s, w s * ∑ t, m t s = 0
'W07.Info.accumulated_centering' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Info.penalty_debit : ∀ {P : Type u_1} {Q : Type u_2} (causal : Set P) (relax : Set Q) (map : P → Q) (J : P → ℝ)
  (F M : Q → ℝ) (L η : ℝ),
  (∀ p ∈ causal, map p ∈ relax) →
    (∀ p ∈ causal, F (map p) ≤ J p) →
      (∀ p ∈ causal, M (map p) ≤ η) → (∀ z ∈ relax, L ≤ F z + M z) → ∀ p ∈ causal, L - η ≤ J p
'W07.Info.penalty_debit' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Info.history_upper : ∀ {S : Type u_1} {H : Type u_2} {A : Type u_3} [inst : Fintype S] [inst_1 : Fintype H]
  [inst_2 : DecidableEq H] (w : S → ℝ) (hist : S → H) (inc : S → A → ℝ) (choose : H → A) (cap : H → ℝ),
  (∀ (h : H) (a : A), (∑ s, if hist s = h then w s * inc s a else 0) ≤ cap h) →
    ∑ s, w s * inc s (choose (hist s)) ≤ ∑ h, cap h
'W07.Info.history_upper' depends on axioms: [propext, Classical.choice, Quot.sound]
@W07.Game.strategy_to_kernel : ∀ {X A R U D : Type} (g : W07.Game.Contract X A R U D) (n b : ℕ) (x : X)
