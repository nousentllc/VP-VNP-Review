'W06.ignoreInformation' does not depend on any axioms
@W06.operationalChain : ∀ {Ω : Type u_1} {O : Type u_2} {A : Type u_3} (physical relaxed : Set (Ω → A)) (obs : Ω → O)
  (deadline : (Ω → A) → Prop) (J : (Ω → A) → ℝ),
  ∀ base ∈ physical,
    W06.adapted obs base →
      deadline base →
        physical ⊆ relaxed →
          ∀ (l : ℝ),
            (∀ p ∈ relaxed, l ≤ J p) →
              have N := {p | p ∈ physical ∧ W06.adapted obs p};
              have C := {p | p ∈ N ∧ deadline p};
              l ≤ sInf (W06.values relaxed J) ∧
                sInf (W06.values relaxed J) ≤ sInf (W06.values physical J) ∧
                  sInf (W06.values physical J) ≤ sInf (W06.values N J) ∧
                    sInf (W06.values N J) ≤ sInf (W06.values C J) ∧ sInf (W06.values C J) ≤ J base
'W06.operationalChain' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.contractCost : ∀ {P : Type u_1} (D : Set P) (J service risk stock : P → ℝ) (b p : P) (l : ℝ),
  (∀ a ∈ D, service a = service b → risk a ≤ risk b → stock a = stock b → l ≤ J a) →
    p ∈ D → service p = service b → risk p ≤ risk b → stock p = stock b → J b - J p ≤ J b - l
'W06.contractCost' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.strictAtNonattainment : ∀ {P : Type u_1} (D : Set P) (J : P → ℝ) (l u e : ℝ),
  (∀ p ∈ D, l ≤ J p) → (¬∃ p ∈ D, J p = l) → u - l ≤ e → ∀ p ∈ D, ¬e ≤ u - J p
'W06.strictAtNonattainment' depends on axioms: [propext, Classical.choice, Quot.sound]
W06.enclosureCeiling : ∀ (baseline candidate baselineUpper modelCost lower allowance : ℝ),
  baseline ≤ baselineUpper →
    lower ≤ modelCost → modelCost ≤ candidate + allowance → baseline - candidate ≤ baselineUpper - lower + allowance
'W06.enclosureCeiling' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.infoPanelInf : ∀ {P : Type u_1} {S : Type u_2} [inst : Fintype S] (D : Set P),
  ∀ b ∈ D,
    ∀ (w l : S → ℝ) (j penalty : P → S → ℝ),
      (∀ (s : S), 0 ≤ w s) →
        (∀ p ∈ D, ∀ (s : S), l s ≤ j p s + penalty p s) →
          (∀ p ∈ D, W06.total w (penalty p) ≤ 0) →
            0 ≤ W06.total w (j b) - sInf (W06.values D fun p => W06.total w (j p)) ∧
              W06.total w (j b) - sInf (W06.values D fun p => W06.total w (j p)) ≤ W06.total w (j b) - W06.total w l
'W06.infoPanelInf' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.Dual.finiteEndpoint : ∀ {r l u x : ℝ}, l ≤ x → x ≤ u → min (r * l) (r * u) ≤ r * x
'W06.Dual.finiteEndpoint' depends on axioms: [propext, Classical.choice, Quot.sound]
W06.Dual.floorTermSound : ∀ (D : W06.Dual.Interval) (r x a : ℝ),
  W06.Dual.contains D x → W06.Dual.floorTerm D r = some a → a ≤ r * x
'W06.Dual.floorTermSound' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.Dual.transposePair : ∀ {I : Type u_1} {J : Type u_2} [inst : Fintype I] [inst_1 : Fintype J] (A : I → J → ℝ)
  (z : I → ℝ) (x : J → ℝ), W06.Dual.dot (W06.Dual.back A z) x = ∑ i, z i * W06.Dual.dot (A i) x
'W06.Dual.transposePair' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.Dual.mixedRowDual : ∀ {I : Type u_1} {J : Type u_2} [inst : Fintype I] [inst_1 : Fintype J] (A : I → J → ℝ)
  (c x : J → ℝ) (z : I → ℝ) (rows : I → W06.Dual.Interval) (cols : J → W06.Dual.Interval) (rowTerms : I → ℝ)
  (colTerms : J → ℝ),
  (∀ (i : I), W06.Dual.contains (rows i) (W06.Dual.dot (A i) x)) →
    (∀ (j : J), W06.Dual.contains (cols j) (x j)) →
      (∀ (i : I), W06.Dual.floorTerm (rows i) (z i) = some (rowTerms i)) →
        (∀ (j : J), W06.Dual.floorTerm (cols j) (c j - W06.Dual.back A z j) = some (colTerms j)) →
          ∑ i, rowTerms i + ∑ j, colTerms j ≤ W06.Dual.dot c x
'W06.Dual.mixedRowDual' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.Dual.boxedDual : ∀ {I : Type u_1} {J : Type u_2} [inst : Fintype I] [inst_1 : Fintype J] {K : Type u_3}
  [inst_2 : Fintype K] (E : K → J → ℝ) (A : I → J → ℝ) (c x l u : J → ℝ) (y d : K → ℝ) (z b : I → ℝ),
  (∀ (k : K), W06.Dual.dot (E k) x = d k) →
    (∀ (i : I), W06.Dual.dot (A i) x ≤ b i) →
      (∀ (i : I), z i ≤ 0) →
        (∀ (j : J), l j ≤ x j) →
          (∀ (j : J), x j ≤ u j) →
            W06.Dual.dot y d + W06.Dual.dot z b +
                ∑ j,
                  min ((c j - W06.Dual.back E y j - W06.Dual.back A z j) * l j)
                    ((c j - W06.Dual.back E y j - W06.Dual.back A z j) * u j) ≤
              W06.Dual.dot c x
'W06.Dual.boxedDual' depends on axioms: [propext, Classical.choice, Quot.sound]
