@W06.transferBound : ∀ {P : Type u_1} {Q : Type u_2} {D : Set P} {R : Set Q} (f : P → Q) (J : P → ℝ) (K : Q → ℝ)
  (l : ℝ), (∀ p ∈ D, f p ∈ R) → (∀ p ∈ D, K (f p) ≤ J p) → (∀ q ∈ R, l ≤ K q) → ∀ p ∈ D, l ≤ J p
'W06.transferBound' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.nestedInf : ∀ {P : Type u_1} (R F N C : Set P) (J : P → ℝ),
  ∀ b ∈ C,
    C ⊆ N →
      N ⊆ F →
        F ⊆ R →
          ∀ (l : ℝ),
            (∀ p ∈ R, l ≤ J p) →
              l ≤ sInf (W06.values R J) ∧
                sInf (W06.values R J) ≤ sInf (W06.values F J) ∧
                  sInf (W06.values F J) ≤ sInf (W06.values N J) ∧
                    sInf (W06.values N J) ≤ sInf (W06.values C J) ∧ sInf (W06.values C J) ≤ J b
'W06.nestedInf' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.totalMono : ∀ {S : Type u_1} [inst : Fintype S] (w x y : S → ℝ),
  (∀ (s : S), 0 ≤ w s) → (∀ (s : S), x s ≤ y s) → W06.total w x ≤ W06.total w y
'W06.totalMono' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.weightedPanel : ∀ {S : Type u_1} [inst : Fintype S] (w u l j : S → ℝ),
  (∀ (s : S), 0 ≤ w s) → (∀ (s : S), l s ≤ j s) → (W06.total w fun s => u s - j s) ≤ W06.total w fun s => u s - l s
'W06.weightedPanel' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.partialPanel : ∀ {S : Type u_1} [inst : Fintype S] (known : S → Prop) [inst_1 : DecidablePred known]
  (w u l fallback j : S → ℝ),
  (∀ (s : S), 0 ≤ w s) →
    (∀ (s : S), known s → l s ≤ j s) →
      (∀ (s : S), ¬known s → fallback s ≤ j s) →
        (W06.total w fun s => u s - j s) ≤ W06.total w fun s => u s - if known s then l s else fallback s
'W06.partialPanel' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.centeredPenalty : ∀ {S : Type u_1} [inst : Fintype S] (w l j penalty : S → ℝ),
  (∀ (s : S), 0 ≤ w s) → (∀ (s : S), l s ≤ j s + penalty s) → W06.total w penalty ≤ 0 → W06.total w l ≤ W06.total w j
'W06.centeredPenalty' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.riskCeiling : ∀ {S : Type u_1} (risk : (S → ℝ) → ℝ) (u l j : S → ℝ) (e : ℝ),
  (∀ (x y : S → ℝ), (∀ (s : S), x s ≤ y s) → risk x ≤ risk y) →
    (∀ (x : S → ℝ), (risk fun s => x s + e) = risk x + e) →
      (∀ (s : S), l s ≤ j s) → (∀ (s : S), u s - l s ≤ e) → risk u - risk j ≤ e
'W06.riskCeiling' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.netBound : ∀ {unit horizon : Type} (u l j k floor : W06.Amount unit horizon),
  l.value ≤ j.value → floor.value ≤ k.value → u.value - j.value - k.value ≤ u.value - l.value - floor.value
'W06.netBound' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.netStop : ∀ {unit horizon : Type} (u l j k floor : W06.Amount unit horizon),
