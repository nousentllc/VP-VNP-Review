'W06.netStop' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.discountedNet : ∀ {S : Type u_1} [inst : Fintype S] (w u l j k f : S → ℝ),
  (∀ (s : S), 0 ≤ w s) →
    (∀ (s : S), l s ≤ j s) →
      (∀ (s : S), f s ≤ k s) → (W06.total w fun s => u s - j s - k s) ≤ W06.total w fun s => u s - l s - f s
'W06.discountedNet' depends on axioms: [propext, Classical.choice, Quot.sound]
@W06.ignoreInformation : ∀ {Ω : Type u_1} {O : Type u_2} {F : Type u_3} {A : Type u_4} (coarse : Ω → O) (fine : Ω → F)
